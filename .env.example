PORT=3000
NODE_ENV=development
KUDAGO_BASE_URL=https://kudago.com/public-api/v1.4/
KUDAGO_TIMEOUT_MS=5000
# Путь к файлу SQLite (кэш событий). Для тестов используется :memory:
DB_PATH=data/afishka.sqlite
# Город по умолчанию (код KudaGo: spb, msk, ...)
DEFAULT_CITY=spb
# Сколько миллисекунд данные в кэше считаются свежими (по умолчанию час)
EVENTS_CACHE_TTL_MS=3600000
# auto — KudaGo, при сбое запасные данные из JSON; fixtures — только запасные данные
EVENT_SOURCE=auto
# JWT_SECRET добавится на шаге с авторизацией
